{
  "manifest_version": 3,
  "name": "MacaroniGraph",
  "version": "0.2.0",
  "description": "Turn your saved Reels into searchable text: local transcription and on-screen text extraction.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabCapture", "offscreen", "tabs", "scripting", "storage", "activeTab"],
  "host_permissions": [
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*",
    "https://www.instagram.com/*"
  ],
  "icons": {
    "16": "ui/icons/icon16.png",
    "32": "ui/icons/icon32.png",
    "48": "ui/icons/icon48.png",
    "128": "ui/icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "MacaroniGraph",
    "default_icon": {
      "16": "ui/icons/icon16.png",
      "32": "ui/icons/icon32.png",
      "48": "ui/icons/icon48.png",
      "128": "ui/icons/icon128.png"
    }
  }
}
